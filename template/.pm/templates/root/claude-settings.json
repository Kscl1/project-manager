{
  "permissions": {
    "allow": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__likec4__list-projects",
      "mcp__likec4__read-project-summary",
      "mcp__likec4__search-element",
      "mcp__likec4__read-element",
      "mcp__likec4__batch-read-elements",
      "mcp__likec4__read-deployment",
      "mcp__likec4__read-view",
      "mcp__likec4__element-diff",
      "mcp__likec4__find-relationships",
      "mcp__likec4__find-relationship-paths",
      "mcp__likec4__query-by-metadata",
      "mcp__likec4__query-by-tag-pattern",
      "mcp__likec4__query-by-tags",
      "mcp__likec4__query-graph",
      "mcp__likec4__query-incomers-graph",
      "mcp__likec4__query-outgoers-graph",
      "mcp__likec4__subgraph-summary"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3); if [ -n \"$PY\" ] && [ -f .pm/tools/pm_board.py ]; then \"$PY\" .pm/tools/pm_board.py --resume; fi",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3); if [ -n \"$PY\" ] && [ -f .pm/tools/pm_board.py ]; then \"$PY\" .pm/tools/pm_board.py --resume; echo; echo 'Context was just compacted. Re-read the active task file named above before the next action.'; fi",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
